# Server
PORT=8000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/auth-project

# JWT signing secret (use a long random string)
TOKEN_SECRET=

# HMAC secret for hashing email/password verification codes
HMAC_VERIFICATION_CODE_SECRET=

# Gmail account used to send verification codes
# Use a Gmail App Password (Google Account > Security > App passwords), not your normal password
NODE_CODE_SENDING_EMAIL_ADDRESS=your_email@gmail.com
NODE_CODE_SENDING_EMAIL_PASSWORD=your_gmail_app_password



